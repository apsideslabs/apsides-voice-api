# Apsides Voice API — example environment file.
# Copy to `.env` and edit. NEVER commit your real `.env`.
# (`.env` is git-ignored; only this example is tracked.)

# --- App -------------------------------------------------------------------
APP_NAME=apsides-voice-api
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Storage ---------------------------------------------------------------
# Persistent directory for downloaded models. On hosts with a mounted volume,
# point this at it (e.g. /data/models).
MODEL_DIR=./models

# --- TTS (Kokoro-82M ONNX q8f16) -------------------------------------------
TTS_ENABLED=true
# TTS_MODEL_PATH=./models/kokoro/onnx/model_q8f16.onnx
# TTS_VOICES_DIR=./models/kokoro/voices
# TTS_VOCAB_PATH=./models/kokoro/vocab.json
TTS_DEFAULT_VOICE=af_heart
TTS_MAX_CHARS=1000
TTS_SPEED_MIN=0.5
TTS_SPEED_MAX=2.0

# --- STT (Moonshine Streaming Small, q8) -----------------------------------
STT_ENABLED=true
STT_LANGUAGE=en
STT_MODEL_ARCH=small_streaming
# STT_MODEL_DIR=/data/models/moonshine
STT_MAX_UPLOAD_MB=25

# --- Runtime / resource controls -------------------------------------------
ONNX_NUM_THREADS=1
MAX_CONCURRENCY_TTS=1
MAX_CONCURRENCY_STT=1
REQUEST_TIMEOUT_S=120

# --- Security / CORS -------------------------------------------------------
# Set API_KEY to require the `X-API-Key` header on /tts and /stt.
# Leave empty to run open (dev only). Generate one, e.g.: openssl rand -hex 32
API_KEY=
# Comma-separated list of allowed origins, or * for any (dev).
CORS_ORIGINS=*
ALLOW_CREDENTIALS=false
